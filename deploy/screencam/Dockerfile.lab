FROM python:3.12-slim@sha256:2f17fc044b579bab302c2e8054d3a686e2cb9a83de48e70534b94cd8ebbe06a9
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    ffmpeg=7:7.1.5-0+deb13u1 xvfb=2:21.1.16-1.3+deb13u4 x11-utils=7.7+7 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY scripts/screencam_config.py scripts/screencam_capture.py scripts/screencam_metrics.py /work/scripts/
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DISPLAY=:99 XDG_SESSION_TYPE=x11
USER 10001:10001
CMD ["sleep", "infinity"]
