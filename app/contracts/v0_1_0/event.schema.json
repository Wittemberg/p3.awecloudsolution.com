          "$ref": "#/$defs/cash_session.closed"
        }
      },
      "required": []
    },
    {
      "properties": {
        "event_type": {
          "const": "cash.supplied"
        },
        "payload": {
          "$ref": "#/$defs/cash.supplied"
        }
      },
      "required": []
    },
    {
      "properties": {
        "event_type": {
          "const": "cash.withdrawn"
        },
        "payload": {
          "$ref": "#/$defs/cash.withdrawn"
        }
      },
      "required": []
    },
    {
      "properties": {
